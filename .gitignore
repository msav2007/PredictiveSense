# Virtual environments
.venv/
venv/
env/

# Python caches / build
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/

# Run artifacts - keep the directory skeleton, ignore all contents
data/**
!data/.gitkeep
!data/videos/
!data/videos/.gitkeep
!data/raw/
!data/raw/.gitkeep
results/*
!results/.gitkeep

# Generated test fixtures (regenerated on demand by tests/fixtures/make_fixture_video.py)
tests/fixtures/*.avi
tests/fixtures/*.mp4
tests/fixtures/*.mkv

# Phase 2 model weights + fetched licence text - never committed. Only
# models/manifest.json (names, sha256, licences, input sizes) is tracked.
models/*
!models/manifest.json

# DirectML benchmark environment (Block 9): separate venv, plain onnxruntime + DML
.venv-dml/

# IDE / editor
.idea/
.vscode/
*.swp
*~
