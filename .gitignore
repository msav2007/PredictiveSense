# Virtual environments
.venv/
venv/
env/

# Python caches / build
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/

# Run artifacts - keep the directory skeleton, ignore all contents
data/**
!data/.gitkeep
!data/videos/
!data/videos/.gitkeep
!data/raw/
!data/raw/.gitkeep
results/*
!results/.gitkeep
# Phase 2.5 audit deliverables (not derived metrics - these are the committed
# record of when `test` was opened and the alternative-model licence evidence).
!results/test_set_openings.md
!results/model_comparison.md

# Generated test fixtures (regenerated on demand by tests/fixtures/make_fixture_video.py)
tests/fixtures/*.avi
tests/fixtures/*.mp4
tests/fixtures/*.mkv

# Phase 2 model weights + fetched licence text - never committed. Only
# models/manifest.json (names, sha256, licences, input sizes) and the Phase 4
# model version registry are tracked.
models/*
!models/manifest.json
!models/registry.json

# DirectML benchmark environment (Block 9): separate venv, plain onnxruntime + DML
.venv-dml/

# IDE / editor
.idea/
.vscode/
*.swp
*~
PredictiveSense-P8-Prompt.md
